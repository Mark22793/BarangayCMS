@model IEnumerable<BarangayCMS.Web.Areas.Staff.ViewModels.ComplaintViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Complaints & Blotter Management";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-header__title"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Complaints & Blotter</h1>
        <p class="page-header__sub text-muted small mb-0">Track, review, and schedule hearings for incident blotters or citizen complaints.</p>
    </div>
    <a href="/Staff/Complaints/Create" class="btn btn-warning text-dark shadow-sm fw-semibold rounded-3">
        <i class="bi bi-file-earmark-medical me-1"></i> File New Case
    </a>
</div>

<div class="app-card app-card--pad">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Case ID / Subject</th>
                    <th>Complainant</th>
                    <th>Incident Details</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">#@item.Subject</td>
                            <td>
                                @if (item.Subject != null && item.Subject.StartsWith("CMP"))
                                {
                                    <span class="text-muted fst-italic"><i class="bi bi-globe me-1 text-primary"></i>Public Web Citizen</span>
                                }
                                else
                                {
                                    @item.ResidentFullName
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 250px;">@item.Description</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
                                }
                                else if (item.Status == "Assigned" || item.Status == "Hearing Scheduled")
                                {
                                    <span class="badge bg-danger-subtle text-danger">@item.Status</span>
                                }
                                else if (item.Status == "Resolved")
                                {
                                    <span class="badge bg-success-subtle text-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a href="/Staff/Complaints/Edit/@item.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a href="/Staff/Complaints/Details/@item.Id" class="btn btn-sm btn-outline-info" title="Details"><i class="bi bi-info-circle"></i></a>
                                    <a href="/Staff/Complaints/UpdateStatus/@item.Id" class="btn btn-sm btn-outline-success" title="Update Status"><i class="bi bi-arrow-repeat"></i></a>
                                    <a href="/Staff/Complaints/Delete/@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-slash display-6 d-block mb-2 opacity-50"></i>
                            <span>No active barangay complaints or blotter cases logged.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>