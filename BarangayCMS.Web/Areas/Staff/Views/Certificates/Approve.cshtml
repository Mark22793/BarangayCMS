@model BarangayCMS.Web.Areas.Staff.ViewModels.CertificateViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Request Details & Verification";
}

<div class="container-fluid px-4 py-3">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-file-earmark-check text-warning me-2"></i> Request Details & Verification
        </h2>
        <p class="text-muted mb-0">Review the details, verify the proof of payment, and adjust the price if needed before issuing.</p>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: REQUEST DETAILS & EDITABLE PRICE -->
        <div class="col-lg-6">
            <form asp-area="Staff" asp-controller="Certificates" asp-action="Generate" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <!-- INAYOS: CertificateId at hindi Id -->
                <input type="hidden" asp-for="CertificateId" />
                <input type="hidden" asp-for="ResidentId" />

                <div class="app-card app-card--pad mb-4">
                    <h5 class="fw-bold text-secondary mb-4 border-bottom pb-2">Information Summary</h5>

                    <div class="mb-3">
                        <span class="text-muted d-block small fw-semibold">Resident Beneficiary</span>
                        <!-- INAYOS: ResidentName at hindi ResidentFullName -->
                        <span class="fs-5 fw-bold text-dark">@Model.ResidentName</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small fw-semibold">Document Form Type</span>
                        <span class="fs-5 fw-bold text-primary">@Model.CertificateType</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Purpose))
                    {
                        <div class="mb-3">
                            <span class="text-muted d-block small fw-semibold">Purpose / Dahilan ng Pagkuha</span>
                            <span class="fs-6 fw-semibold text-dark">@Model.Purpose</span>
                        </div>
                    }

                    <div class="mb-3">
                        <span class="text-muted d-block small fw-semibold">Date Requested</span>
                        <span class="fs-6 fw-semibold text-dark">@Model.DateRequested.ToString("MMMM dd, yyyy")</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small fw-semibold">Current Status</span>
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 mt-1">@Model.Status</span>
                    </div>

                    <hr class="my-4" />

                    <!-- EDITABLE PRICE FIELD -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-success">
                            <i class="bi bi-cash-coin me-1"></i> Final Amount / Fee (₱)
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-success text-white fw-bold">₱</span>
                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control form-control-lg border-success fw-bold text-success"
                                   id="FeePaid"
                                   name="FeePaid"
                                   value="@Model.FeePaid.ToString("0.00")"
                                   placeholder="0.00" />
                        </div>
                        <small class="text-muted">Maaari mong palitan ang halaga rito base sa beripikasyon sa resibo.</small>
                        <span asp-validation-for="FeePaid" class="text-danger small"></span>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="app-card app-card--pad bg-light">
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-between">
                        <a href="/Staff/Certificates" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </a>

                        <div class="d-flex gap-2">
                            <button type="submit" name="Status" value="Rejected" class="btn btn-danger px-4 py-2 fw-bold shadow-sm rounded-3">
                                <i class="bi bi-x-circle me-1"></i> Reject
                            </button>

                            <button type="submit" name="Status" value="Issued" class="btn btn-success px-4 py-2 fw-bold shadow-sm rounded-3">
                                <i class="bi bi-check-circle me-1"></i> Approve & Issue
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- RIGHT COLUMN: PROOF OF PAYMENT PREVIEW -->
        <div class="col-lg-6">
            <div class="app-card app-card--pad h-100 d-flex flex-column">
                <div class="border-bottom pb-3 mb-3">
                    <h5 class="m-0 fw-bold text-dark">
                        <i class="bi bi-image text-primary me-2"></i>Proof of Payment
                    </h5>
                </div>
                <div class="d-flex flex-column align-items-center justify-content-center bg-light rounded-3 p-4 flex-grow-1">
                    @if (!string.IsNullOrEmpty(Model.PaymentReceiptPath))
                    {
                        <div class="text-center w-100">
                            <p class="text-muted small mb-3">I-click ang larawan upang buksan ito sa malaking view.</p>

                            <a href="@Model.PaymentReceiptPath" target="_blank" title="Click to view full image">
                                <img src="@Model.PaymentReceiptPath" class="img-fluid rounded shadow-sm border" style="max-height: 400px; object-fit: contain; cursor: pointer; transition: 0.3s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'" />
                            </a>

                            <div class="mt-3">
                                <a href="@Model.PaymentReceiptPath" target="_blank" class="btn btn-outline-primary btn-sm fw-semibold rounded-3">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Full Image
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-receipt-cutoff text-muted display-1 d-block mb-3"></i>
                            <span class="text-muted fw-semibold">Walang inupload na Proof of Payment ang residente.</span>
                            <p class="text-muted small px-3 mt-1">Maaaring ito ay walk-in o libreng transaksyon gaya ng Indigency.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>