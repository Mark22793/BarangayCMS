@model BarangayCMS.Web.Areas.Admin.Models.ReportsDashboardViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "System Analytical Reports";
}

<!-- CDN FOR CHART.JS AT HTML2PDF -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
    .btn-export-pdf {
        background-color: #212529;
        color: #ffffff;
        border: 1px solid #212529;
        transition: all 0.3s ease;
    }

    .btn-export-pdf:hover {
        background-color: #dc3545 !important;
        border-color: #dc3545 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 10px rgba(220, 53, 69, 0.35);
    }

    .trend-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 6px;
    }
</style>

<!-- BANNER AT EXPORT NAVIGATION -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-graph-up-arrow me-2" style="color: #6b46c1;"></i>Reports Engine
        </h2>
        <p class="text-muted small mb-0">Compile demographic, safety incidents, and general transaction report datasets.</p>
    </div>

    <!-- DIRECT PDF DOWNLOAD BUTTON -->
    <button type="button" onclick="downloadPDF()" class="btn btn-export-pdf shadow-sm">
        <i class="bi bi-download me-1"></i> Export PDF Summary
    </button>
</div>

<!-- MGA ANALYTICAL COUNTERS -->
<div class="row g-3 mb-4">
    <!-- Residents -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Total Residents</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalResidents</h3>
                </div>
                <div class="bg-light p-2 rounded text-primary">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-primary-subtle text-primary trend-badge">
                    <i class="bi bi-person-plus-fill me-1"></i>@Model.ResidentTrendStatus
                </span>
            </div>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Residents" class="text-decoration-none small text-primary mt-3 d-block fw-semibold">
                View Dataset <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>

    <!-- Complaints -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Blotter Cases</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalComplaints</h3>
                </div>
                <div class="bg-light p-2 rounded text-danger">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-warning-subtle text-dark trend-badge">
                    <i class="bi bi-activity me-1"></i>@Model.ComplaintTrendStatus
                </span>
            </div>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Complaints" class="text-decoration-none small text-danger mt-3 d-block fw-semibold">
                View Dataset <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>

    <!-- Budget -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Total Budget Allocated</h6>
                    <h3 class="fw-bold text-dark mb-0">₱@Model.TotalBudget.ToString("N2")</h3>
                </div>
                <div class="bg-light p-2 rounded text-success">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-success-subtle text-success trend-badge">
                    <i class="bi bi-check-circle me-1"></i>Active Allocation
                </span>
            </div>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Budget" class="text-decoration-none small text-success mt-3 d-block fw-semibold">
                View Dataset <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>

    <!-- Certificates -->
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Certificates Issued</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalCertificatesIssued</h3>
                </div>
                <div class="bg-light p-2 rounded text-info">
                    <i class="bi bi-file-earmark-text-fill fs-4"></i>
                </div>
            </div>
            <div class="mt-2">
                <span class="badge bg-info-subtle text-info trend-badge">
                    <i class="bi bi-calendar-check me-1"></i>@Model.CertificatesIssuedThisMonth ngayong buwan
                </span>
            </div>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Certificates" class="text-decoration-none small text-info mt-3 d-block fw-semibold">
                View Dataset <i class="bi bi-arrow-right-short"></i>
            </a>
        </div>
    </div>
</div>

<!-- DEMOGRAPHIC ANALYTICS -->
<div class="d-flex align-items-center mb-3">
    <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people text-primary me-2"></i>Demographic Analytics</h5>
    <span class="badge bg-light text-dark small ms-2">Live mula sa Resident Records</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Total Registered Population</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.TotalRegisteredPopulation</h3>
                </div>
                <div class="bg-light p-2 rounded text-primary"><i class="bi bi-people-fill fs-4"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Youth Population</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.YouthPopulation</h3>
                </div>
                <div class="bg-light p-2 rounded text-info"><i class="bi bi-person-arms-up fs-4"></i></div>
            </div>
            <small class="text-muted mt-2">Edad 15–30 (SK)</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">Senior Citizen Population</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.SeniorCitizenPopulation</h3>
                </div>
                <div class="bg-light p-2 rounded text-warning"><i class="bi bi-person-walking fs-4"></i></div>
            </div>
            <small class="text-muted mt-2">Edad 60 pataas</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted small text-uppercase mb-1">PWD Population</h6>
                    <h3 class="fw-bold text-dark mb-0">@Model.PwdPopulation</h3>
                </div>
                <div class="bg-light p-2 rounded text-success"><i class="bi bi-universal-access fs-4"></i></div>
            </div>
            <small class="text-muted mt-2">Persons With Disability</small>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Population Distribution by Age Group</h6>
                <span class="badge bg-light text-dark small">Total: @Model.TotalRegisteredPopulation</span>
            </div>
            <div style="min-height: 280px; height: 280px;"><canvas id="ageGroupChart"></canvas></div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart-fill text-info me-2"></i>Demographic Classification</h6>
            </div>
            <div style="min-height: 280px; height: 280px;"><canvas id="demographicChart"></canvas></div>
        </div>
    </div>
</div>

<!-- VISUAL CHARTS SECTION (MONTHLY TRENDS) -->
<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-activity text-danger me-2"></i>Monthly Incident & Resident Growth Trend
                </h6>
                <span class="badge bg-light text-dark small">Year @DateTime.Now.Year</span>
            </div>
            <div style="min-height: 260px; height: 260px;">
                <canvas id="monthlyTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-file-earmark-bar-graph text-info me-2"></i>Monthly Certificates Issued
                </h6>
                <span class="badge bg-light text-dark small">Monthly Breakdown</span>
            </div>
            <div style="min-height: 260px; height: 260px;">
                <canvas id="certificatesChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- SUB-MODULE LINKS -->
<div class="card border-0 shadow-sm rounded p-4 mb-4">
    <h5 class="fw-bold text-dark mb-3">Analytical Matrix Datasets</h5>
    <div class="row row-cols-1 row-cols-md-3 g-2">
        <div class="col">
            <a asp-area="Admin" asp-controller="Reports" asp-action="Projects" class="btn btn-outline-secondary w-100 text-start py-2">
                <i class="bi bi-building me-2"></i> Infrastructure Projects Monitored
            </a>
        </div>
        <div class="col">
            <a asp-area="Admin" asp-controller="Reports" asp-action="Disaster" class="btn btn-outline-secondary w-100 text-start py-2">
                <i class="bi bi-shield-exclamation me-2"></i> Disaster Evacuation Logs
            </a>
        </div>
        <div class="col">
            <a asp-area="Admin" asp-controller="Reports" asp-action="Health" class="btn btn-outline-secondary w-100 text-start py-2">
                <i class="bi bi-heart-pulse me-2"></i> Health Center Summary Logs
            </a>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- 📄 HIDDEN PDF TEMPLATE (EKSAKTONG FORMAT MULA SA TEMPLATE MO) -->
<!-- ========================================================= -->
<div style="display: none;">
    <div id="pdf-report-template" style="width: 750px; padding: 40px; font-family: Arial, sans-serif; color: #111827; background-color: #ffffff; line-height: 1.4;">
        
        <!-- HEADER -->
        <div style="text-align: center; margin-bottom: 15px;">
            <h1 style="font-size: 20px; font-weight: 800; margin: 0; color: #000000; text-transform: uppercase;">BARANGAY TATALON</h1>
            <h2 style="font-size: 18px; font-weight: 700; margin: 2px 0 0 0; color: #000000; text-transform: uppercase;">MANAGEMENT SYSTEM</h2>
            <div style="font-size: 12px; font-weight: 800; color: #374151; margin-top: 6px; text-transform: uppercase; letter-spacing: 0.5px;">EXECUTIVE ANALYTICS & MANAGEMENT REPORT</div>
            <div style="font-size: 10px; color: #4b5563; margin-top: 4px;">
                Generated: @DateTime.Now.ToString("MMMM dd, yyyy • h:mm tt")
            </div>
        </div>

        <hr style="border: 0; border-top: 1.5px solid #000000; margin: 10px 0 15px 0;" />

        <!-- 1. EXECUTIVE SUMMARY -->
        <div style="font-size: 11px; font-weight: 800; color: #000000; margin-bottom: 4px; text-transform: uppercase;">1. EXECUTIVE SUMMARY</div>
        <p style="font-size: 10px; color: #374151; margin: 0 0 15px 0; text-align: justify;">
            This report provides a consolidated overview of administrative, demographic, document-processing, financial, health, disaster, and incident records maintained within the Barangay Management System. The information is intended to support authorized barangay personnel in monitoring current operational records.
        </p>

        <!-- 2. KEY SYSTEM INDICATORS -->
        <div style="font-size: 11px; font-weight: 800; color: #000000; margin-bottom: 6px; text-transform: uppercase;">2. KEY SYSTEM INDICATORS</div>
        <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; padding: 8px 12px; font-size: 9.5px; font-weight: 700; color: #1e293b; margin-bottom: 15px; line-height: 1.8;">
            REGISTERED RESIDENTS @Model.TotalResidents &nbsp;|&nbsp; INCIDENT CASES @Model.TotalComplaints &nbsp;|&nbsp; CERTIFICATES ISSUED @Model.TotalCertificatesIssued &nbsp;|&nbsp; ACTIVE PROJECTS @Model.ActiveProjects<br />
            APPROVED BUDGET ₱@Model.TotalBudget.ToString("N2") &nbsp;|&nbsp; ACTIVE EVACUEES @Model.ActiveEvacuees &nbsp;|&nbsp; HEALTH RECORDS @Model.TotalHealthRecords &nbsp;|&nbsp; REPORT STATUS CURRENT
        </div>

        <!-- 3. RESIDENT & DEMOGRAPHIC OVERVIEW -->
        <div style="font-size: 11px; font-weight: 800; color: #000000; margin-bottom: 6px; text-transform: uppercase;">3. RESIDENT & DEMOGRAPHIC OVERVIEW</div>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 10px;">
            <thead>
                <tr style="border-bottom: 1px solid #000000; text-align: left;">
                    <th style="padding: 4px 0; font-weight: 800;">Category</th>
                    <th style="padding: 4px 0; font-weight: 800;">Count</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Total Registered Population</td>
                    <td style="padding: 4px 0; font-weight: 700;">@Model.TotalRegisteredPopulation</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Youth Population (15-30)</td>
                    <td style="padding: 4px 0; font-weight: 700;">@Model.YouthPopulation</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Senior Citizen Population (60+)</td>
                    <td style="padding: 4px 0; font-weight: 700;">@Model.SeniorCitizenPopulation</td>
                </tr>
                <tr>
                    <td style="padding: 4px 0;">PWD Population</td>
                    <td style="padding: 4px 0; font-weight: 700;">@Model.PwdPopulation</td>
                </tr>
            </tbody>
        </table>

        <!-- 4. SYSTEM METRICS SUMMARY -->
        <div style="font-size: 11px; font-weight: 800; color: #000000; margin-bottom: 6px; text-transform: uppercase;">4. SYSTEM METRICS SUMMARY</div>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 10px;">
            <thead>
                <tr style="border-bottom: 1px solid #000000; text-align: left;">
                    <th style="padding: 4px 0; font-weight: 800;">Module Category</th>
                    <th style="padding: 4px 0; font-weight: 800; text-align: right;">Database Total</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Total Registered Residents</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.TotalResidents</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Total Blotter Cases / Complaints</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.TotalComplaints</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Total Certificates Issued</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.TotalCertificatesIssued</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Approved Allocated Budget</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">₱@Model.TotalBudget.ToString("N2")</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Active Infrastructure Projects</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.ActiveProjects</td>
                </tr>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="padding: 4px 0;">Active Evacuees Monitored</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.ActiveEvacuees</td>
                </tr>
                <tr>
                    <td style="padding: 4px 0;">Total Health Center Records Logged</td>
                    <td style="padding: 4px 0; text-align: right; font-weight: 700;">@Model.TotalHealthRecords</td>
                </tr>
            </tbody>
        </table>

        <!-- FOOTER -->
        <div style="text-align: center; border-top: 1px solid #e5e7eb; padding-top: 12px; font-size: 9px; color: #6b7280;">
            <div style="font-weight: 800; color: #374151; text-transform: uppercase; margin-bottom: 2px;">OFFICIAL SYSTEM-GENERATED REPORT</div>
            This report contains administrative information generated from records maintained within the system. Data should be reviewed by authorized barangay personnel before official use.
        </div>

    </div>
</div>

<!-- SCRIPTS FOR CHARTS & DIRECT PDF GENERATION -->
<script>
    function downloadPDF() {
        const element = document.getElementById('pdf-report-template');
        const opt = {
            margin:       [0.4, 0.4, 0.4, 0.4],
            filename:     'Barangay_CMS_Executive_Report.pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, logging: false },
            jsPDF:        { unit: 'in', format: 'letter', orientation: 'portrait' }
        };
        html2pdf().set(opt).from(element).save();
    }

    document.addEventListener("DOMContentLoaded", function () {
        const labelsArray = @Html.Raw(Json.Serialize(Model.Months));
        const complaintsData = @Html.Raw(Json.Serialize(Model.MonthlyComplaints));
        const certificatesData = @Html.Raw(Json.Serialize(Model.MonthlyCertificates));
        const residentsData = @Html.Raw(Json.Serialize(Model.MonthlyResidents));

        const ageGroupLabels = @Html.Raw(Json.Serialize(Model.AgeGroupLabels));
        const ageGroupCounts = @Html.Raw(Json.Serialize(Model.AgeGroupCounts));
        const youthPop = @Model.YouthPopulation;
        const seniorPop = @Model.SeniorCitizenPopulation;
        const pwdPop = @Model.PwdPopulation;
        const totalPop = @Model.TotalRegisteredPopulation;
        const generalPop = Math.max(0, totalPop - youthPop - seniorPop);

        // Bar Chart: Age Group
        const ctxAge = document.getElementById('ageGroupChart').getContext('2d');
        new Chart(ctxAge, {
            type: 'bar',
            data: {
                labels: ageGroupLabels,
                datasets: [{
                    label: 'Number of Residents',
                    data: ageGroupCounts,
                    backgroundColor: ['#6c757d', '#0dcaf0', '#0d6efd', '#ffc107'],
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // Doughnut: Demographic
        const ctxDemo = document.getElementById('demographicChart').getContext('2d');
        new Chart(ctxDemo, {
            type: 'doughnut',
            data: {
                labels: ['Youth (15-30)', 'Senior (60+)', 'PWD', 'General (31-59)'],
                datasets: [{
                    data: [youthPop, seniorPop, pwdPop, generalPop],
                    backgroundColor: ['#0dcaf0', '#ffc107', '#198754', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Line Chart: Trends
        const ctxTrend = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(ctxTrend, {
            type: 'line',
            data: {
                labels: labelsArray,
                datasets: [
                    {
                        label: 'Blotter Cases / Complaints',
                        data: complaintsData,
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 4
                    },
                    {
                        label: 'New Resident Registrations',
                        data: residentsData,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.05)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // Bar Chart: Certificates
        const ctxCert = document.getElementById('certificatesChart').getContext('2d');
        new Chart(ctxCert, {
            type: 'bar',
            data: {
                labels: labelsArray,
                datasets: [{
                    label: 'Certificates Issued',
                    data: certificatesData,
                    backgroundColor: '#0dcaf0',
                    borderColor: '#0baccc',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    });
</script>